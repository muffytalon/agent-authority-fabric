/target/

# Spikes: never commit installed packages, virtualenvs, sockets or run outputs.
# Each spike's run.sh works outside the repo; these catch anything run in place.
/spikes/**/node_modules/
/spikes/**/.venv/
/spikes/**/venv/
/spikes/**/pyenv/
/spikes/**/__pycache__/
/compose/__pycache__/
/spikes/**/*.sock
/spikes/**/*.err
/spikes/**/*.log
/spikes/**/*.client.txt
# ...except the logs a spike keeps as evidence.
!/spikes/*/results/*.log
!/spikes/*/results/*.client.txt

# Backstop only: credentials live in $PEP_SECRETS_DIR, outside the repo and OneDrive (WEEK2_PLAN.md section 4).
secrets/

# compose/gate1.py's per-suite logs: the reports in reports/ carry the results.
/reports/gate1-logs/
